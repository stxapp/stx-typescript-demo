# Copy to .env and fill in. Everything is env-driven.

# The STX exchange to integrate with. Point at the preview sandbox:
STX_BASE_URL=https://sx-12476.preview.sportsxapp.com

# ---- ISV OAuth client (the demo's identity) --------------------------------
# The preview sandbox "Heater" client, registered for :8787/callback.
CLIENT_ID=stx_client_sandbox_heater
CLIENT_SECRET=stx_secret_sandbox_heater_do_not_use_in_prod
# Must EXACTLY match a redirect URI registered for the client above.
REDIRECT_URI=http://localhost:8787/callback
# Space-delimited scopes to request.
OAUTH_SCOPES=identity balance portfolio history trade
# Port the demo server listens on (must match REDIRECT_URI's port).
PORT=8787

# ---- Direct-trader signing snippet (optional) ------------------------------
# Only needed to run `npm run signing`.
STX_KEY_ID=
# Path to a PKCS#8 Ed25519 private key PEM.
STX_PRIVATE_KEY_PATH=./stx-key.pem
